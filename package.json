{
  "name": "homework-helper",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first homework planning, scheduling, focus, and tutoring workspace.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "server:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 install",
    "server:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 uninstall",
    "server:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 start",
    "server:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 stop",
    "server:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 restart",
    "server:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 update",
    "server:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-dev-server.ps1 status"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
